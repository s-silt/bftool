{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bftool Migration Candidate",
  "version": "0.1.11-rc.2",
  "identifier": "io.github.s-silt.bftool.candidate",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -File ../../scripts/project-npm.ps1 run dev",
    "beforeBuildCommand": "powershell -NoProfile -File ../../scripts/project-npm.ps1 run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bftool · 文件备份候选",
        "width": 1080,
        "height": 800,
        "minWidth": 420,
        "minHeight": 540,
        "create": false
      }
    ],
    "security": {
      "capabilities": [
        "backup-main"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
