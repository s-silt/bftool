# 注意：所有 CSV 索引文件均为 UTF-8 编码，建议用支持 UTF-8 的工具查看（如 VS Code、记事本 Win11+）。
# 归档备份工具 配置文件示例
#
# 用法：
#   1. 复制本文件为 bftool.toml（放在 bftool.exe 同目录、当前目录、或 %APPDATA%\bftool\config.toml 三选一）
#   2. 修改下面三个根目录为你自己的路径
#   3. 直接运行 bftool，它会自动按此配置工作
#
# 不放配置文件也能用，但会使用内置默认路径（D:\资料库\待备份 等），通常不是你要的——
# 建议复制本文件为 bftool.toml 并把下面三个根目录改成你自己的。

# 待归档（源）目录：每个子文件夹 = 一个项目
ready_root    = "D:\\资料库\\待备份"

# 已归档目录：校验通过后源被移到这里（仍在 SSD，永不删除，用户决定是否手动清理）
archived_root = "D:\\资料库\\已备份"

# 系统/索引/日志目录：跑出来的全局索引、日志、序号、需人工处理等都在这里
system_root   = "D:\\资料库\\备份系统"

# 每盘要留多少空闲余量（GB），低于这个数即视为"放不下下一个项目"，封盘换盘
reserve_gb = 30

# 文件最近修改须早于现在 N 分钟才算"稳定"，否则跳过（避免归档正在编辑的文件）
stable_minutes = 30

# 自动认盘的最小容量（GB），低于此的盘不会被认为是"候选备份盘"，防止误抓 U 盘
min_drive_gb = 200

# 备份盘命名前缀，会得到「备份1、备份2…」；改成 "BK" 就是 BK1、BK2
name_prefix = "备份"

# -------- 压缩包内部测试(Spec B / Batch 3.5) --------
# 默认开。装了 7-Zip / WinRAR / Bandizip 任一就自动用,新手不用动这一段。

# 默认 true。--no-test-archives 关掉。
# 注意:不是"两个开关本身互斥"。被拒绝的是「同时关闭 SHA256(--unsafe-no-hash)
# 且关闭 archive test」这一组合 —— 那样只剩 文件数+大小+修改时间,等于没做完整性校验。
# 单独关 archive test(SHA256 仍开)是允许的;单独用 SHA256(archive test 关)也允许。
test_archives = true

# WinRAR(优先) / Bandizip / 7-Zip 路径。装哪个就保留哪个对应行有效路径。
# 没装的话保持默认值也行 —— detect 会按 is_file 找,找不到一次性 warn 后继续 SHA256。
winrar_path   = "C:\\Program Files\\WinRAR\\WinRAR.exe"
bandizip_path = "C:\\Program Files\\Bandizip\\bz.exe"
seven_zip_path = "C:\\Program Files\\7-Zip\\7z.exe"

# -------- 多机汇总查询(可选) --------
# 其它电脑拷来的「备份索引名单.csv」路径列表;find 查询时与本机索引一并检索。
# 只读,不影响本机归档/盘号/事务。建议各机用不同 name_prefix,结果里好区分来源。
# 不需要就保持空数组 []。GUI 设置页可点选添加(支持一次多选)。
# 例:
# extra_catalogs = ["D:\\汇总\\A.csv", "D:\\汇总\\B.csv"]
extra_catalogs = []
